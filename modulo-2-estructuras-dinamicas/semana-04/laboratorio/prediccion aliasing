nueva_lista = agregar_elemento_copia(mi_lista, 4)
print(f"3.2 copia:    mi_lista  = {mi_lista}   (esperado: [1, 2, 3] — sin cambios)")
print(f"             nueva_lista = {nueva_lista}  (esperado: [1, 2, 3, 4])")

