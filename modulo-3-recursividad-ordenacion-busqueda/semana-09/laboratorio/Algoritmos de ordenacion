import time
import random


# =============================================================================
# ALGORITMOS DE ORDENACIÓN
# Implementa cada función. IMPORTANTE: trabaja sobre una COPIA del arreglo
# (usa lista[:] o list(lista)) para no alterar el original en las comparaciones.
# =============================================================================

def burbuja(arr):
    """
    Ordena arr de menor a mayor usando bubble sort.
    Optimización: si en una pasada no hubo intercambios, el arreglo ya está ordenado.
    Retorna la lista ordenada (copia, no modifica el original).
    Complejidad: O(n) mejor caso (con flag), O(n²) promedio y peor caso.
    """
    lista = list(arr)  # trabaja sobre copia
    n = len(lista)
    
    for i in range(n):
        hubo_intercambio = False
        # En cada iteración i, los últimos i elementos ya están ordenados y no hay que revisarlos
        for j in range(0, n - i - 1):
            # Si el elemento actual es mayor al siguiente, se intercambian
            if lista[j] > lista[j + 1]:
                lista[j], lista[j + 1] = lista[j + 1], lista[j]
                hubo_intercambio = True
        
        # Si no hubo ningún intercambio en esta pasada, la lista ya está ordenada
        if not hubo_intercambio:
            break
            
    return lista


def seleccion(arr):
    """
    Ordena arr de menor a mayor usando selection sort.
    En cada iteración, encuentra el mínimo del resto y lo lleva a su posición.
    Retorna la lista ordenada (copia).
    Complejidad: O(n²) en todos los casos.
    """
    lista = list(arr)
    n = len(lista)
    
    for i in range(n - 1):
        # Suponemos que el mínimo está en la posición i
        indice_minimo = i
        
        # Buscamos en el resto del arreglo si hay un elemento más pequeño
        for j in range(i + 1, n):
            if lista[j] < lista[indice_minimo]:
                indice_minimo = j
                
        # Intercambiamos el mínimo encontrado con el elemento en la posición i
        if indice_minimo != i:
            lista[i], lista[indice_minimo] = lista[indice_minimo], lista[i]
            
    return lista


def insercion(arr):
    """
    Ordena arr de menor a mayor usando insertion sort.
    Eficiente para arreglos pequeños o casi ordenados.
    Retorna la lista ordenada (copia).
    Complejidad: O(n) mejor caso (casi ordenado), O(n²) promedio y peor caso.
    """
    lista = list(arr)
    n = len(lista)
    
    for i in range(1, n):
        # El elemento que vamos a insertar en la sublista ya ordenada
        elemento_actual = lista[i]
        
        # Comenzamos a comparar con los elementos anteriores (ya ordenados)
        j = i - 1
        
        # Mientras estemos dentro de la lista y el elemento anterior sea mayor,
        # desplazamos el elemento anterior un espacio hacia la derecha
        while j >= 0 and lista[j] > elemento_actual:
            lista[j + 1] = lista[j]
            j -= 1
            
        # Insertamos el elemento en su posición correcta
        lista[j + 1] = elemento_actual
        
    return lista


# =============================================================================
# AMPLIACIÓN OPCIONAL: merge sort (O(n log n))
# =============================================================================

def merge_sort(arr):
    """
    Ordena arr usando merge sort (dividir y vencer).
    Retorna una nueva lista ordenada.
    Complejidad: O(n log n) en todos los casos. No es in situ (requiere memoria extra).
    """
    # Caso base: una lista vacía o con un solo elemento ya está ordenada
    if len(arr) <= 1:
        return list(arr)
        
    # 1. DIVIDIR: partimos la lista por la mitad
    medio = len(arr) // 2
    mitad_izquierda = arr[:medio]
    mitad_derecha = arr[medio:]
    
    # 2. VENCER: ordenamos recursivamente ambas mitades
    izquierda_ordenada = merge_sort(mitad_izquierda)
    derecha_ordenada = merge_sort(mitad_derecha)
    
    # 3. COMBINAR: juntamos ambas mitades ordenadas (merge)
    resultado = []
    i = j = 0
    
    # Mientras ambas listas tengan elementos
    while i < len(izquierda_ordenada) and j < len(derecha_ordenada):
        if izquierda_ordenada[i] <= derecha_ordenada[j]:
            resultado.append(izquierda_ordenada[i])
            i += 1
        else:
            resultado.append(derecha_ordenada[j])
            j += 1
            
    # Añadimos los elementos que sobraron (solo una de las dos listas tendrá elementos restantes)
    resultado.extend(izquierda_ordenada[i:])
    resultado.extend(derecha_ordenada[j:])
    
    return resultado


# =============================================================================
# GENERADORES DE ARREGLOS DE PRUEBA
# =============================================================================

def arreglo_aleatorio(n, minval=1, maxval=10_000):
    return [random.randint(minval, maxval) for _ in range(n)]

def arreglo_ordenado(n):
    return list(range(1, n + 1))

def arreglo_invertido(n):
    return list(range(n, 0, -1))

def arreglo_casi_ordenado(n, swaps=5):
    arr = list(range(1, n + 1))
    for _ in range(swaps):
        i, j = random.sample(range(n), 2)
        arr[i], arr[j] = arr[j], arr[i]
    return arr


# =============================================================================
# FUNCIÓN DE MEDICIÓN
# =============================================================================

def medir_tiempo(algoritmo, arr):
    """Ejecuta `algoritmo(arr)` y retorna (resultado, segundos)."""
    t0 = time.perf_counter()
    resultado = algoritmo(arr)
    t1 = time.perf_counter()
    return resultado, t1 - t0


# =============================================================================
# VERIFICACIÓN DE CORRECTITUD
# =============================================================================

def verificar_todos(casos_prueba):
    """Verifica que todos los algoritmos producen el mismo resultado que sorted()."""
    print("Verificando correctitud...")
    for desc, arr in casos_prueba:
        esperado = sorted(arr)
        # Añadido merge_sort a las pruebas de correctitud
        for nombre, func in [("burbuja", burbuja), ("seleccion", seleccion), ("insercion", insercion), ("merge_sort", merge_sort)]:
            resultado = func(arr)
            ok = resultado == esperado
            print(f"  [{('OK' if ok else 'ERROR')}] {nombre:10s} en '{desc}'")
            if not ok:
                print(f"       esperado: {esperado[:10]}...")
                print(f"       obtenido: {resultado[:10]}...")


