import os

if __name__ == "__main__":

    p = []

    contador = True
    while contador == True:
     os.system('cls')  # Limpiar la pantalla 

     print("\n 1. Agregar elementos a la pila")
     print("\n 2. Eliminar elementos de la pila")
     print("\n 3. Mostrar el tope de la pila")
     print("\n 4. Mostrar tamaño de la pila y contenido de la pila")
     opcion = int(input(" Escoja una opción: "))
    

     match opcion:
        case 1:
            elemento = input("Ingrese el elemento a agregar a la pila: ")

            p.append(elemento) #guarda el elemento en p

            print(f"\nElemento {elemento} agregado a la pila.")

        case 2:
            if len(p) == 0:
                print("\nLa pila está vacía. No se puede eliminar ningún elemento.")
            else:
                elemento_eliminado = p.pop() #extrae el ultimo elemento de p y lo elimina
                print(f"\nElemento '{elemento_eliminado}' eliminado de la pila.")

        case 3:
            if len(p) > 0:  # si p es mayor que 0 se puede observar que hay en p      
               ultimo_elemento = p[-1]
               print(f"\nElemento en el tope de la pila: {ultimo_elemento}")
            else: 
                print("\nLa pila está vacía. No hay elementos en el tope.")

        case 4:
            tamaño = len(p)
            print(f"\nTamaño actual de la pila: {tamaño}")# Muestra el numero de la pila
            print(f"\nContenido de la pila: {p}")  # Muestra la pila completa

        case _:
            print("Opción no válida. Por favor, elija una opción del 1 al 4.")

     print("\n quieres hacer algo mas con la pila? Si/No")

     tan=input("Ingrese su opción: \n").lower()
    
     if(tan=="si"):
        contador=True
     else:
        contador=False

